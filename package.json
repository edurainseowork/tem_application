{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "start": "pnpm --filter @workspace/frontend exec expo start",
    "web": "pnpm --filter @workspace/frontend exec expo start --web",
    "android": "pnpm --filter @workspace/frontend exec expo run:android",
    "ios": "pnpm --filter @workspace/frontend exec expo run:ios",
    "build": "pnpm run typecheck && pnpm -r --if-present run build",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./Frontend\" --filter \"./Backend\" --filter \"./scripts\" --if-present run typecheck",
    "dev:all": "concurrently \"pnpm --filter @workspace/backend dev\" \"pnpm --filter @workspace/frontend exec expo run:android\"",
    "dev": "concurrently \"pnpm --filter @workspace/backend dev\" \"pnpm --filter @workspace/frontend exec expo start\""
  },
  "private": true,
  "devDependencies": {
    "concurrently": "^10.0.5",
    "lightningcss-win32-x64-msvc": "^1.33.0",
    "prettier": "^3.9.6",
    "typescript": "~5.9.3"
  }
}