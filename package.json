{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "start": "pnpm --filter @workspace/study-sprint exec expo start",
    "web": "pnpm --filter @workspace/study-sprint exec expo start --web",
    "android": "pnpm --filter @workspace/study-sprint exec expo run:android",
    "ios": "pnpm --filter @workspace/study-sprint exec expo run:ios",
    "build": "pnpm run typecheck && pnpm -r --if-present run build",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck"
  },
  "private": true,
  "dependencies": {},
  "devDependencies": {
    "lightningcss-win32-x64-msvc": "^1.33.0",
    "prettier": "^3.9.6",
    "typescript": "~5.9.3"
  }
}
