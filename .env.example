# Backend (loaded by `pnpm --filter @workspace/backend start` from ../.env)
PORT=5000
DATABASE_URL=postgresql://user:password@host:5432/dbname
NODE_ENV=development

# Comma-separated browser origins allowed to call the API (the CMS). Required in production;
# in development all origins are allowed when empty. Native mobile requests are unaffected.
CORS_ORIGINS=http://localhost:5173

# Absolute base URL used to build thumbnail/media URLs, e.g. https://api.edurain.in.
# When empty, the request's own host is used (fine for local dev).
PUBLIC_BASE_URL=

# Number of proxies in front of the API (e.g. 1 behind API Gateway / a load balancer).
TRUST_PROXY=

# Firebase Admin credentials as a JSON string (alternative to Backend/firebase-service-account.json).
FIREBASE_SERVICE_ACCOUNT=

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# CMS (CMS-Portal/.env.local)
VITE_API_URL=http://localhost:5000

# Mobile app
EXPO_PUBLIC_API_URL=http://localhost:5000
