+                    className="btn"
+                    style={{ background: '#ff5e5e', border: 'none', padding: '6px 12px', fontSize: '0.8rem', opacity: course.enrollmentCount > 0 ? 0.5 : 1 }}
+                  >
+                    Delete
+                  </button>
+                </div>
+              </div>
+            ))}
+          </div>
+        )}
+      </div>
+
+      {/* Create / Edit Course Form */}
+      <div className="glass-card">
