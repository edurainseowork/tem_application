{
  "expo": {
    "name": "EDURAIN",
    "slug": "edurainindia",
    "owner": "edurainindia",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "edurain",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.edurainindia.app",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Allow EDURAIN to access your files and documents for course content uploads."
      }
    },
    "android": {
      "package": "com.edurainindia.app",
      "permissions": [
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "READ_MEDIA_IMAGES",
        "READ_MEDIA_VIDEO"
      ]
    },
    "web": {
      "favicon": "./assets/images/edurain-logo.jpg"
    },
    "plugins": [
      "expo-router",
      [
        "expo-document-picker",
        {
          "iCloudContainerEnvironment": "Production"
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#ff6b4a",
          "defaultChannel": "default"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "de7a99e0-3c7e-4173-a866-6a316d37a0f2"
      }
    }
  }
}
