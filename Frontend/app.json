{
  "expo": {
    "name": "EDURAIN",
    "slug": "edurain",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/images/edurain-logo.jpg",
    "scheme": "edurain",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.edurain.app",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Allow EDURAIN to access your files and documents for course content uploads."
      }
    },
    "android": {
      "package": "com.edurain.app",
      "permissions": [
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "READ_MEDIA_IMAGES",
        "READ_MEDIA_VIDEO"
      ]
    },
    "web": {
      "favicon": "./assets/images/edurain-logo.jpg"
    },
    "plugins": [
      "expo-router",
      [
        "expo-document-picker",
        {
          "iCloudContainerEnvironment": "Production"
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#ff6b4a",
          "defaultChannel": "default"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
